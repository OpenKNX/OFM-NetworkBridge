<?xml version="1.0" encoding="utf-8"?>
<?xml-model href="../../../../Organization/knxprod-support/knx_project_20/knx-editor.xsd" type="application/xml" schematypens="http://www.w3.org/2001/XMLSchema"?>
<KNX xmlns:op="http://github.com/OpenKNX/OpenKNXproducer" xmlns="http://knx.org/xml/project/20" CreatedBy="KNX MT" ToolVersion="5.1.255.16695">
    <op:minOpenKNXproducerVersion value="3.13.1" />
    <op:config name="%NTB_NumChannelsDefault%" value="0" />
    <ManufacturerData>
        <Manufacturer>
            <ApplicationPrograms>
                <ApplicationProgram>
                    <Static>
                        <ParameterTypes>
                            <ParameterType Id="%AID%_PT-NTBNumChannels" Name="NTBNumChannels">
                                <TypeNumber SizeInBit="8" Type="unsignedInt" minInclusive="0" maxInclusive="%N%" />
                            </ParameterType>
                            <ParameterType Id="%AID%_PT-NTBChannelType" Name="NTBChannelType">
                                <TypeRestriction Base="Value" SizeInBit="8" UIHint="DropDown">
                                    <Enumeration Id="%ENID%" Value="0" Text="Deaktiviert" />
                                    <Enumeration Id="%ENID%" Value="1" Text="Ping" />
                                    <Enumeration Id="%ENID%" Value="2" Text="Wake on LAN" />
                                </TypeRestriction>
                            </ParameterType>
                            <ParameterType Id="%AID%_PT-NTBHostAddress" Name="NTBHostAddress">
                                <TypeIPAddress AddressType="HostAddress" />
                            </ParameterType>
                            <ParameterType Id="%AID%_PT-NTBPingRetries" Name="NTBPingRetries">
                                <TypeNumber SizeInBit="8" Type="unsignedInt" minInclusive="0" maxInclusive="10" />
                            </ParameterType>
                            <ParameterType Id="%AID%_PT-NTBPingTimeout" Name="NTBPingTimeout">
                                <TypeNumber SizeInBit="16" Type="unsignedInt" minInclusive="100" maxInclusive="10000" />
                            </ParameterType>
                            <ParameterType Id="%AID%_PT-NTBMacAddress" Name="NTBMacAddress">
                                <TypeText SizeInBit="136" Pattern="^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$" />
                            </ParameterType>
                        </ParameterTypes>
                        <Parameters>
                            <Union SizeInBit="8">
                                <Memory CodeSegment="%MID%" Offset="0" BitOffset="0" />
                                <Parameter Id="%AID%_UP-%TT%00000" Name="VisibleChannels" ParameterType="%AID%_PT-NTBNumChannels" Offset="0" BitOffset="0" Text="Verfuegbare Kanaele" Value="%NTB_NumChannelsDefault%" SuffixText=" von %N%" />
                            </Union>
                            <Parameter Id="%AID%_P-%TT%00001" Name="AddNotAllowed" ParameterType="%AID%_PT-OnOffYesNo" Text="AddNotAllowed" Value="0" Access="None" />
                        </Parameters>
                        <ParameterRefs>
                            <ParameterRef Id="%AID%_UP-%TT%00000_R-%TT%0000001" RefId="%AID%_UP-%TT%00000" />
                            <ParameterRef Id="%AID%_P-%TT%00001_R-%TT%0000101" RefId="%AID%_P-%TT%00001" />
                        </ParameterRefs>
                        <ComObjectTable>
                        </ComObjectTable>
                        <ComObjectRefs>
                        </ComObjectRefs>
                        <Script>
                            <op:include href="NetworkBridge.script.js" prefix="NTB" type="script" />
                        </Script>
                    </Static>
                    <Dynamic>
                        <Channel Name="MainChannel%TT%" Text="Network Bridge" Number="%PREFIX%" Id="%AID%_CH-%TT%" Icon="table-network" HelpContext="NTB-Dokumentation">
                            <ParameterBlock Id="%AID%_PB-nnn" Name="NTBSettings" Text="Allgemein" Icon="cog-outline" HelpContext="NTB-Dokumentation">
                                <ParameterSeparator Id="%AID%_PS-nnn" Text="Network Bridge" UIHint="Headline" />
                                <ParameterSeparator Id="%AID%_PS-nnn" Text="Version: %ModuleVersion%" />
                                <ParameterSeparator Id="%AID%_PS-nnn" Text="" UIHint="HorizontalRuler" />
                                <ParameterSeparator Id="%AID%_PS-nnn" Text="Kanalauswahl" UIHint="Headline" />
                                <ParameterRefRef IndentLevel="1" RefId="%AID%_UP-%TT%00000_R-%TT%0000001" HelpContext="NTB-Verfuegbare-Kanaele" />

                                <op:include href="NetworkBridge.templ.xml" xpath="//Dynamic/ChannelIndependentBlock/ParameterBlock[@Name='Settings']/*" type="template" prefix="NTB" IsInner="true" />
                            </ParameterBlock>

                            <op:include href="NetworkBridge.templ.xml" xpath="//Dynamic/ChannelIndependentBlock/ParameterBlock[@Name='Channel']/*" type="template" prefix="NTB" IsInner="true" />

                            <choose ParamRefId="%AID%_UP-%TT%00000_R-%TT%0000001">
                                <when test="&lt;%N%">
                                    <ParameterBlock Id="%AID%_PB-nnn" Name="NTBAdditionalChannels" Text="(mehr)" Icon="dots-horizontal">
                                        <ParameterSeparator Id="%AID%_PS-nnn" Text="Kanalauswahl" UIHint="Headline" />
                                        <op:include href="NetworkBridge.templ.xml" xpath="//Dynamic/ChannelIndependentBlock/ParameterBlock[@Name='More']/*" type="template" prefix="NTB" IsInner="true" />

                                        <ParameterRefRef RefId="%AID%_P-%TT%00001_R-%TT%0000101" />
                                        <choose ParamRefId="%AID%_P-%TT%00001_R-%TT%0000101">
                                            <when test="1">
                                                <ParameterSeparator Id="%AID%_PS-nnn" Text="Hinzufuegen von 'Deaktiviert' nicht moeglich. Es muss zuerst ein Typ gewaehlt werden." UIHint="Error" />
                                            </when>
                                        </choose>

                                        <Button Id="%AID%_B-%TT%00200" Text="Hinzufuegen" EventHandler="nbAddChannel" />
                                    </ParameterBlock>
                                </when>
                            </choose>
                        </Channel>
                    </Dynamic>
                </ApplicationProgram>
            </ApplicationPrograms>
            <Baggages>
                <Baggage TargetPath="" Name="Help_de.zip" Id="%FILE-HELP-de%">
                    <FileInfo TimeInfo="%DATETIME%" />
                </Baggage>
                <Baggage TargetPath="" Name="Icons.zip" Id="%FILE-ICONS%">
                    <FileInfo TimeInfo="%DATETIME%" />
                </Baggage>
            </Baggages>
        </Manufacturer>
    </ManufacturerData>
</KNX>
